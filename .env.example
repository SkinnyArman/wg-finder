# --- OpenAI (only used to read the ad and draft the reply) ---
OPENAI_API_KEY=sk-...

# Recommended: strong writing, ~$0.01 per ad drafted.
OPENAI_MODEL=gpt-5.6-terra
# Budget alternative (~10x cheaper, ~$0.001 per ad): gpt-5.6-luna
# Max quality (~2x pricier):                          gpt-5.6-sol

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Behaviour ---
POLL_MINUTES=15
MAX_PER_HOUR=2
BLOCK_BACKOFF_MIN=45
